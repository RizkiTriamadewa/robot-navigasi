# ============================================================
# .htaccess untuk folder public/
# ============================================================
# - Default index: index.php (dashboard)
# - Tidak ada directory listing
# - URL pretty (opsional): /login -> login.php, /api -> api.php
# ============================================================

DirectoryIndex index.php

# Matikan listing folder
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Tambah .php otomatis bila user mengetik URL tanpa ekstensi
    # Contoh: /login -> /login.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# Set proper Content-Type & disable PHP error display di production
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
